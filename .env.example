# Litigation — provider API keys (copy to .env and fill in)
# Only fill in the providers you use; models without keys show as offline.

# Big four
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=
GEMINI_API_KEY=

# Aggregators / routers
OPENROUTER_API_KEY=        # https://openrouter.ai
HF_TOKEN=                  # https://huggingface.co/settings/tokens
OPENCODE_API_KEY=          # OpenCode Zen (https://opencode.ai/zen)

# Direct providers
DEEPSEEK_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=
TOGETHER_API_KEY=
FIREWORKS_API_KEY=
PERPLEXITY_API_KEY=
CEREBRAS_API_KEY=
SAMBANOVA_API_KEY=
NOVITA_API_KEY=

# Local servers (no key needed, just leave them running)
# Ollama:  http://localhost:11434/v1   (ollama serve)
# LM Studio: http://localhost:1234/v1  (start the local server tab)

# Optional model overrides — every provider above has a <PREFIX>_MODEL var,
# e.g. OPENAI_MODEL, OPENROUTER_MODEL, HF_MODEL, OLLAMA_MODEL, ...
# OPENAI_MODEL=gpt-4o-mini
# ANTHROPIC_MODEL=claude-sonnet-4-5
# XAI_MODEL=grok-4
# GEMINI_MODEL=gemini-2.5-flash

# Optional: any other OpenAI-compatible endpoint as a JSON array, e.g.
# LITIGATION_EXTRA_MODELS=[{"id":"vllm","label":"vLLM","color":"#f59e0b","base_url":"http://localhost:8000/v1","default_model":"my-model","env_key":""}]

# Server
# LITIGATION_PORT=8766
